// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url   = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  firstName String
  lastName  String?
  username  String
  password  String
  img       String?
  role      Role
  location String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Log       Log[]
  Order    Order[]
}

model Log {
  id        String   @id @default(uuid())
  action    String
  createdAt DateTime @default(now())

  userId String
  user   User?  @relation(fields: [userId], references: [id])
}

model Product {
  id            String   @id @default(uuid())
  name          String
  barcode       String
  category      Category @relation(fields: [categoryId], references: [id])
  categoryId    String
  compatibility String[]
  images        String[]
  brand         String
  location      String
  notes         String?
  variant       String
  stock         Int
  alertammount  Int
  sellprice     Float
  buyprice      Float
  isDeleted     Boolean  @default(false)

  orderItems   OrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  Product     Product[]
}

model Sucursales {
  id          String   @id @default(uuid())
  name        String
  description String
  use         Use
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proveedores {
  id          String @id @default(uuid())
  companyName String
  companyPhone String?
  companyEmail String?
  contactName String?
  contactPhone String?
  contactEmail String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model Clientes {
  id     String @id @default(uuid())
  nombre String
  codigo String @unique
  descuento Int
  Razon  String?
  orders Order[]
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order{
  id        String @id @default(uuid())
  nickname  String
  total     Float
  realTotal Float?
  orderPrice Float
  paymentmethod String?
  location String?
  debt    Float?
  pay_debt Float?
  change  Float?
  pay_received Float?
  last_payment Float?
  descuento Float?
  clienteID String?
  cliente Clientes? @relation(fields: [clienteID], references: [id])
  userID String
  user User @relation(fields: [userID], references: [id])
  items      OrderItem[]
  status     Status
  sellDate  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order @relation(fields: [orderId],references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  priceAtSale Float
}

model Gastos {
  id      String @id @default(uuid())
  name    String
  amount  Int 
  isDeleted Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notifications{
  id    String @id @default(uuid())
  message String 
  read   Boolean @default(false)
  createdAt DateTime @default(now())
}

enum Status {
  activo
  completada
  cancelado
}

enum Use {
  tienda
  almacen
  taller
}

enum Role {
  admin
  vendor
  user
}
